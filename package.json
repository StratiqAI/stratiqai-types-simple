{
  "name": "@stratiqai/types-simple",
  "version": "1.0.75",
  "description": "TypeScript types, GraphQL schema, and operations for StratiqAI",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./events/constants": {
      "types": "./dist/events/constants.d.ts",
      "import": "./dist/events/constants.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js"
    },
    "./generated/types": {
      "types": "./src/generated/types.ts",
      "import": "./src/generated/types.ts"
    },
    "./utils/SchemaNormalizer": {
      "types": "./dist/utils/SchemaNormalizer.d.ts",
      "import": "./dist/utils/SchemaNormalizer.js"
    },
    "./utils/ZodSchemaAdapter": {
      "types": "./dist/utils/ZodSchemaAdapter.d.ts",
      "import": "./dist/utils/ZodSchemaAdapter.js"
    },
    "./utils/SchemaFingerprint": {
      "types": "./dist/utils/SchemaFingerprint.d.ts",
      "import": "./dist/utils/SchemaFingerprint.js"
    },
    "./schema": "./src/graphql/schema.graphql"
  },
  "files": [
    "dist",
    "src/generated/types.ts",
    "src/graphql/schema.graphql"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:js && npm run build:types && npm run generate:types",
    "build:js": "node esbuild.config.js",
    "build:types": "tsc --emitDeclarationOnly --project tsconfig.json",
    "generate:types": "graphql-codegen --config codegen.yml",
    "fingerprint:demo": "npx --yes tsx scripts/print-schema-fingerprint.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run generate:types",
    "prepublishOnly": "npm run build",
    "publish:local": "npm run build && npm version patch && npm publish --registry http://localhost:4873"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.2",
    "@graphql-codegen/near-operation-file-preset": "^4.0.0",
    "@graphql-codegen/typescript": "^5.0.4",
    "@graphql-codegen/typescript-operations": "^5.0.4",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.0",
    "graphql": "^16.8.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "graphql-tag": "^2.12.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
